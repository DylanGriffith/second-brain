schema items {
    document items {
        field global_id type string {
            indexing: summary | attribute
            match: word
        }

        field namespace type string {
            indexing: summary | attribute
            match: word
        }

        field url type string {
            indexing: summary | attribute
            match: word
        }

        field title type string {
            indexing: summary | index
            index: enable-bm25
        }

        field domain type string {
            indexing: summary | attribute
            match: word
        }

        field snippet type string {
            indexing: summary | index
            index: enable-bm25
        }

        field content type string {
            indexing: summary | index
            index: enable-bm25
        }

        field last_seen type long {
            indexing: summary | attribute
        }
    }

    field embedding type tensor<float>(x[384]) {
            indexing: input title . " " . input snippet | embed e5 | attribute | index
            attribute {
                distance-metric: angular
            }
            index {
                hnsw {
                    max-links-per-node: 32
                    neighbors-to-explore-at-insert: 200
                }
            }
    }

    fieldset default {
        fields: title, snippet
    }

    document-summary id_only {
        summary global_id { }
    }

    rank-profile bm25 {
        first-phase {
            expression: bm25(title) + bm25(snippet) + bm25(content)
        }
    }

    rank-profile closeness {
        num-threads-per-search: 1
        match-features: distance(field, embedding)

        inputs {
            query(q)  tensor<float>(x[384])
            query(q1) tensor<float>(x[384])
        }

        first-phase {
            expression: closeness(field, embedding)
        }
    }

    rank-profile closeness-label inherits closeness {
        match-features: closeness(label, q) closeness(label, q1)
    }

    rank-profile hybrid inherits closeness {
        inputs {
            query(wText) : 1.0
            query(wVector) : 1.0
        }
        first-phase {
            expression {
                query(wText) * log(bm25(title) + bm25(snippet) + bm25(content)) +
                query(wVector) * closeness(field, embedding)
            }
        }
        match-features {
            bm25(title)
            bm25(snippet)
            bm25(content)
            closeness(field, embedding)
            distance(field, embedding)
        }
    }
}
